#!/usr/bin/env bash
set -euo pipefail

if [[ $# -ne 1 ]]; then
  echo "Usage: $0 <backup.dump>"
  exit 1
fi

BACKUP_FILE="$1"
COMPOSE_FILE="${COMPOSE_FILE:-docker-compose.yml}"
CONTAINER="${POSTGRES_CONTAINER:-tripare-postgres}"
DB_USER="${POSTGRES_USER:-bookings}"
RESTORE_DB="${RESTORE_DB:-bookings_restore}"

if [[ ! -s "$BACKUP_FILE" ]]; then
  echo "Backup file does not exist or is empty: $BACKUP_FILE"
  exit 1
fi

echo "Preparing fresh database: ${RESTORE_DB}"

docker compose -f "$COMPOSE_FILE" exec -T "$CONTAINER" \
  psql -U "$DB_USER" -d postgres -v ON_ERROR_STOP=1 \
  -c "SELECT pg_terminate_backend(pid) FROM pg_stat_activity WHERE datname = '${RESTORE_DB}' AND pid <> pg_backend_pid();" \
  -c "DROP DATABASE IF EXISTS ${RESTORE_DB};" \
  -c "CREATE DATABASE ${RESTORE_DB};"

echo "Restoring ${BACKUP_FILE} into ${RESTORE_DB}"

cat "$BACKUP_FILE" | docker compose -f "$COMPOSE_FILE" exec -T "$CONTAINER" \
  pg_restore -U "$DB_USER" -d "$RESTORE_DB" --no-owner --exit-on-error

echo "Restore completed successfully."

docker compose -f "$COMPOSE_FILE" exec -T "$CONTAINER" \
  psql -U "$DB_USER" -d "$RESTORE_DB" \
  -c "SELECT 'hotel_bookings' AS table_name, COUNT(*) AS row_count FROM hotel_bookings
      UNION ALL
      SELECT 'booking_events', COUNT(*) FROM booking_events;"
